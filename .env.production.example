# Copy to .env.production (do not commit). See deploy/SUPABASE_SETUP.md
#   cp .env.production.example .env.production
#   set -a && source .env.production && set +a
#   ./scripts/run_web.sh          # local against real Supabase
#   ./scripts/build_web.sh        # production Hostinger build

DATA_SOURCE=supabase
PUBLIC_BASE_URL=https://kaydo.sayge.in
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Required for Supabase: Cloudflare Turnstile site key (public forms)
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
